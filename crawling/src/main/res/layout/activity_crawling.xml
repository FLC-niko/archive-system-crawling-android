<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_background"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    tools:context=".ui.CrawlingActivity">

    <!-- Material 3 Top App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/md_theme_surface"
        app:elevation="0dp">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            app:title="AAOS 自动化采集"
            app:titleTextAppearance="@style/TextAppearance.Material3.TitleLarge"
            app:titleTextColor="@color/text_primary"
            app:subtitle="微信自动化任务调度与控制台"
            app:subtitleTextAppearance="@style/TextAppearance.Material3.BodySmall"
            app:subtitleTextColor="@color/text_secondary" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/md_theme_outlineVariant" />

    </com.google.android.material.appbar.AppBarLayout>

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingBottom="24dp">
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingTop="12dp">
            android:paddingTop="10dp">

            <!-- Section 1: 运行技术统计 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp"
                android:text="运行统计"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <!-- 已成功卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/stat_success_container"
                    app:cardCornerRadius="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stat_success_badge"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="9dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_check_circle"
                                app:tint="@color/stat_success_text"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_marginStart="5dp"
                                android:text="已成功"
                                android:textColor="@color/stat_success_text"
                                android:textSize="13sp"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_stat_success"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginTop="2dp"
                            android:gravity="end"
                            android:text="0"
                            android:textColor="@color/stat_success_text"
                            android:textSize="26sp"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 已完成卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/stat_completed_container"
                    app:cardCornerRadius="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stat_completed_badge"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="9dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_task_alt"
                                app:tint="@color/stat_completed_text"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_marginStart="5dp"
                                android:text="已完成"
                                android:textColor="@color/stat_completed_text"
                                android:textSize="13sp"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_stat_completed"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginTop="2dp"
                            android:gravity="end"
                            android:text="0"
                            android:textColor="@color/stat_completed_text"
                            android:textSize="26sp"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal">

                <!-- 队列中卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/stat_enqueuing_container"
                    app:cardCornerRadius="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stat_enqueuing_badge"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="9dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_hourglass"
                                app:tint="@color/stat_enqueuing_text"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_marginStart="5dp"
                                android:text="队列中"
                                android:textColor="@color/stat_enqueuing_text"
                                android:textSize="13sp"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_stat_enqueuing"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginTop="2dp"
                            android:gravity="end"
                            android:text="0"
                            android:textColor="@color/stat_enqueuing_text"
                            android:textSize="26sp"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <!-- 成功率卡片 -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    app:cardBackgroundColor="@color/stat_rate_container"
                    app:cardCornerRadius="16dp"
                    app:cardCornerRadius="14dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/stat_rate_badge"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="12dp">
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="9dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:layout_width="16dp"
                                android:layout_height="16dp"
                                android:src="@drawable/ic_insights"
                                app:tint="@color/stat_rate_text"
                                tools:ignore="ContentDescription" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="6dp"
                                android:layout_marginStart="5dp"
                                android:text="成功率"
                                android:textColor="@color/stat_rate_text"
                                android:textSize="13sp"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_stat_rate"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginTop="2dp"
                            android:gravity="end"
                            android:text="0 %"
                            android:textColor="@color/stat_rate_text"
                            android:textSize="26sp"
                            android:textSize="24sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>

            <!-- Section 2: 运行模式设置 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginTop="12dp"
                android:text="运行模式配置"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="16dp"
                    android:paddingVertical="14dp">
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="11dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_tune"
                            app:tint="@color/md_theme_primary"
                            tools:ignore="ContentDescription" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:text="独立运行模式"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switch_standalone_mode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/tv_standalone_mode_desc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:lineSpacingExtra="3dp"
                        android:layout_marginTop="4dp"
                        android:lineSpacingExtra="2dp"
                        android:text="开启：直接从 RabbitMQ 消费主任务队列\n(当前状态：独立模式)"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />
                        android:textSize="12sp" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 3: 授权与服务初始化 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginTop="12dp"
                android:text="权限与环境配置"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardBackgroundColor="@color/card_surface"
                app:cardCornerRadius="16dp"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/card_stroke"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="12dp">
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="9dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_vpn_permission"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="start|center_vertical"
                        android:paddingVertical="12dp"
                        android:paddingVertical="10dp"
                        android:text="授权启动 VPN 代理服务"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:cornerRadius="12dp"
                        android:textSize="13sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_vpn_key"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/md_theme_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_system_permission"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="6dp"
                        android:layout_marginBottom="4dp"
                        android:gravity="start|center_vertical"
                        android:paddingVertical="12dp"
                        android:paddingVertical="10dp"
                        android:text="授权管理微信缓存文件"
                        android:textAllCaps="false"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        app:cornerRadius="12dp"
                        android:textSize="13sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_folder"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/md_theme_primary" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_shizuku_permission"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="start|center_vertical"
                        android:paddingVertical="12dp"
                        android:paddingVertical="10dp"
                        android:text="Shizuku 服务授权（当前版本未启用）"
                        android:textAllCaps="false"
                        android:textColor="@color/text_secondary"
                        android:textSize="14sp"
                        app:cornerRadius="12dp"
                        android:textSize="13sp"
                        app:cornerRadius="10dp"
                        app:icon="@drawable/ic_terminal"
                        app:iconGravity="textStart"
                        app:iconPadding="10dp"
                        app:iconTint="@color/text_secondary"
                        app:strokeColor="@color/card_stroke" />

                </LinearLayout>

            </com.google.android.material.card.MaterialCardView>

            <!-- Section 4: AC 服务统计 -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:layout_marginBottom="6dp"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginTop="12dp"
                android:text="AC 统计与数据查询"
                android:textColor="@color/text_primary"
                android:textSize="15sp"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ac_video_room"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="6dp"
                    android:layout_marginEnd="5dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:paddingVertical="12dp"
                    android:text="视频列表"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:cornerRadius="14dp"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_video_library"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconPadding="6dp"
                    app:iconTint="@color/md_theme_secondary" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_ac_limited_room"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginStart="5dp"
                    android:layout_weight="1"
                    android:gravity="center"
                    android:paddingVertical="14dp"
                    android:paddingVertical="12dp"
                    android:text="用户列表"
                    android:textAllCaps="false"
                    android:textColor="@color/text_primary"
                    android:textSize="14sp"
                    app:cornerRadius="14dp"
                    android:textSize="13sp"
                    app:cornerRadius="12dp"
                    app:icon="@drawable/ic_people"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    app:iconPadding="6dp"
                    app:iconTint="@color/md_theme_tertiary" />

            </LinearLayout>

            <!-- Section 5: 核心主行动点 -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_start_aaos"
                style="@style/Widget.Material3.Button.ElevatedButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="22dp"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:paddingVertical="15dp"
                android:paddingVertical="14dp"
                android:text="启动 AAOS 服务"
                android:textAllCaps="false"
                android:textColor="@color/md_theme_onPrimary"
                android:textSize="16sp"
                android:textStyle="bold"
                app:backgroundTint="@color/md_theme_primary"
                app:cornerRadius="24dp"
                app:elevation="4dp"
                app:elevation="3dp"
                app:icon="@drawable/ic_play_arrow"
                app:iconGravity="textStart"
                app:iconPadding="10dp"
                app:iconTint="@color/md_theme_onPrimary" />

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</LinearLayout>